<?xml version="1.0" encoding="utf-8"?>
<!-- Application CVTT Vaires : le site (mise à jour), l'espace club et les statistiques, en onglets. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="fr.cvtt.vaires">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/nom_appli"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".Principale"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lien partagé avec l'appli (Chrome : Partager > CVTT Vaires) : ouvert dans son onglet ;
                 un lien de partage Umami devient la page de départ de l'onglet Umami -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Images partagées (WhatsApp, SMS...) : lues par l'appli choisie, le temps du partage -->
        <provider
            android:name=".Fichiers"
            android:authorities="fr.cvtt.vaires.fichiers"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
